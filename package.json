{
  "name": "kingside",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "node backend/dist/server.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @kingside/frontend test:e2e",
    "db:indexes": "pnpm --filter @kingside/backend db:indexes",
    "import:puzzles": "pnpm --filter @kingside/backend import:puzzles"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.9",
    "typescript": "7.0.2"
  }
}
