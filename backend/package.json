{
  "name": "@kingside/backend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:indexes": "tsx --env-file-if-exists=.env ../packages/db/src/scripts/sync-indexes.ts",
    "import:puzzles": "tsx --env-file-if-exists=.env ../packages/db/src/scripts/import-puzzles.ts",
    "db:daily": "tsx --env-file-if-exists=.env ../packages/db/src/scripts/daily-puzzles.ts",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@kingside/chess-core": "workspace:*",
    "@kingside/db": "workspace:*",
    "@kingside/uci": "workspace:*",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kingside/config": "workspace:*",
    "@types/node": "24",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
