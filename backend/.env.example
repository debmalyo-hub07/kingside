# Copy to backend/.env and fill in. Never commit the real file.

PORT=8787

# Frontend origins allowed to call this API (comma-separated, supports project-scoped wildcards like https://kingsidechess-*.vercel.app).
CORS_ORIGINS="http://localhost:3000,https://kingsidechess.vercel.app,https://kingsidechess-*.vercel.app"

# Optional proxy trust override ("true" behind Render/Vercel/nginx, "false" when exposed directly).
# Defaults to auto-detecting private/loopback proxy peers.
TRUST_PROXY=""

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Use a least-privilege user (readWrite on MONGODB_DB only).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=kingside"
MONGODB_DB="kingside"

# Optional: Redis-compatible URL for rate limiting/cache (Valkey locally, Upstash in prod).
REDIS_URL=""

# Contact info sent in User-Agent to Chess.com / Lichess APIs (their API guidelines ask for it).
API_CONTACT="you@example.com"

# Optional: Lichess personal API token for the opening explorer (masters + Lichess stats).
# Create at https://lichess.org/account/oauth/token (no scopes needed). Without it the app uses
# its own CC0 opening book instead.
LICHESS_TOKEN=""

# Optional: Native server-side Stockfish fallback for constrained mobile devices (/api/engine/eval).
SERVER_ENGINE_ENABLED="false"
STOCKFISH_BIN=""
SERVER_ENGINE_HASH_MB=16
SERVER_ENGINE_MAX_NODES=400000
SERVER_ENGINE_MAX_QUEUE=4
SERVER_ENGINE_TIMEOUT_MS=15000
